{
  "name": "persistence-delivery",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/persistence/features/delivery/src",
  "projectType": "library",
  "tags": ["scope:infrastructure", "type:persistence", "feature:delivery"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/persistence/features/delivery/tsconfig.lib.json --noEmit",
          "tsc -p libs/persistence/features/delivery/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/persistence/features/delivery/vitest.config.ts"
      }
    }
  }
}
