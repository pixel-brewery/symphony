{
  "name": "application-skills",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/application/features/skills/src",
  "projectType": "library",
  "tags": ["scope:application", "type:application", "feature:skills"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/application/features/skills/tsconfig.lib.json --noEmit",
          "tsc -p libs/application/features/skills/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/application/features/skills/vitest.config.ts"
      }
    }
  }
}
