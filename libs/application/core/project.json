{
  "name": "application-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/application/core/src",
  "projectType": "library",
  "tags": ["scope:application", "type:application", "feature:core"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/application/core/tsconfig.lib.json --noEmit",
          "tsc -p libs/application/core/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/application/core/vitest.config.ts"
      }
    }
  }
}
