{
  "name": "domain-skills",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/features/skills/src",
  "projectType": "library",
  "tags": ["scope:domain", "type:domain", "feature:skills"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/domain/features/skills/tsconfig.lib.json --noEmit",
          "tsc -p libs/domain/features/skills/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/domain/features/skills/vitest.config.ts"
      }
    }
  }
}
