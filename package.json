{
  "name": "symphony",
  "productName": "Symphony",
  "description": "A local-first Electron application for coordinating provider-neutral software-delivery workflows.",
  "keywords": [
    "agent-orchestration",
    "coding-agents",
    "software-delivery",
    "github-projects",
    "git-worktrees",
    "pull-requests",
    "local-first",
    "electron",
    "codex",
    "claude-code",
    "opencode"
  ],
  "version": "0.1.47",
  "private": true,
  "author": "Pixel Brewery and Symphony contributors",
  "license": "MIT",
  "homepage": "https://github.com/pixel-brewery/symphony",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-brewery/symphony.git"
  },
  "type": "module",
  "main": "dist/apps/desktop/main.mjs",
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.8"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "nx": {
    "includedScripts": [],
    "projectType": "application",
    "tags": [
      "scope:desktop",
      "type:application"
    ]
  },
  "scripts": {
    "agents:sync": "python3 .agents/scripts/sync_agent_configuration.py",
    "agents:check": "python3 .agents/scripts/sync_agent_configuration.spec.py && python3 .agents/scripts/package_skills.spec.py && python3 .agents/scripts/sync_agent_configuration.py --check",
    "skills:package": "python3 .agents/scripts/package_skills.py",
    "skills:check": "python3 .agents/scripts/package_skills.py --check",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t build --projects=desktop,orchestrator && concurrently -k \"nx serve renderer\" \"wait-on http://127.0.0.1:4200 && cross-env SYMPHONY_RENDERER_URL=http://127.0.0.1:4200 electron .\"",
    "start": "yarn package && node tools/start-packaged-app.mjs",
    "start:unpackaged": "yarn build && electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:md": "mosaik-design-md generate",
    "design:md-check": "mosaik-design-md check",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "verify": "yarn verify:public-content && yarn test:public-content && yarn agents:check && yarn instruction:check && yarn design:md-check && yarn format:check && yarn intl:analyze && yarn intl:lint && yarn intl:references && yarn lint && yarn typecheck && yarn test && yarn build",
    "test:e2e": "nx e2e renderer-e2e",
    "e2e": "yarn test:e2e",
    "e2e:visible": "cross-env SYMPHONY_E2E_WINDOW_MODE=visible yarn test:e2e",
    "package": "yarn build && electron-forge package",
    "make": "yarn build && electron-forge make",
    "package:smoke": "yarn package && node tools/package-smoke.mjs",
    "forge:package": "yarn package:smoke",
    "icons:generate": "node tools/generate-app-icons.mjs",
    "release": "yarn run release:patch",
    "release:major": "gh workflow run release.yml --ref main -f specifier=major",
    "release:minor": "gh workflow run release.yml --ref main -f specifier=minor",
    "release:patch": "gh workflow run release.yml --ref main -f specifier=patch",
    "release:dry-run": "yarn run release:nx --specifier=patch --dry-run",
    "release:nx": "nx release --skip-publish",
    "release:version": "node tools/set-release-version.mjs",
    "release:prepare": "node tools/prepare-update-publication.mjs",
    "update": "GITHUB_TOKEN=\"${GITHUB_TOKEN:-${YARN_NPM_AUTH_TOKEN:-$(gh auth token)}}\" yarn upgrade-interactive",
    "spell": "yarn run cspell-cli --gitignore .",
    "instruction:check": "node tools/instruction-compliance.mjs --strict",
    "verify:public-content": "node tools/verify-public-content.mjs",
    "test:public-content": "node --test tools/verify-public-content.spec.mjs",
    "intl:analyze": "node --test tools/i18n/check-catalog-files.spec.mjs && node tools/i18n/check-catalog-files.mjs && nx run frontend-intl:intl:analyze",
    "intl:sort": "nx run frontend-intl:intl:sort",
    "intl:lint": "nx run frontend-intl:intl-lint",
    "intl:references": "nx run frontend-intl:intl-references"
  },
