{
  "name": "renderer-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/renderer-e2e/src",
  "projectType": "application",
  "implicitDependencies": ["desktop", "mobile", "orchestrator", "renderer"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["desktop:build", "mobile:build", "orchestrator:build", "renderer:build"],
      "options": { "command": "playwright test --config apps/renderer-e2e/playwright.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/renderer-e2e" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/renderer-e2e/tsconfig.json --noEmit" }
    }
  },
  "tags": ["scope:testing", "type:e2e"]
}
