{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nx": {
      "type": "local",
      "command": ["npx", "nx", "mcp"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "angular": {
      "type": "local",
      "command": ["npx", "-y", "@angular/cli", "mcp"],
      "enabled": true
    },
    "mosaik": {
      "type": "remote",
      "url": "https://beta.api.mosaik.breadstone.de/api/mcp",
      "enabled": true
    }
  }
}
