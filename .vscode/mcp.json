{
  "servers": {
    "nx": {
      "type": "stdio",
      "command": "npx",
      "args": ["nx", "mcp"]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceFolder}"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "angular": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "mosaik": {
      "type": "stdio",
      "command": "yarn",
      "args": ["exec", "mosaik-mcp"],
      "cwd": "${workspaceFolder}"
    }
  }
}
